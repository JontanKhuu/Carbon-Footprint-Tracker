# CORS Configuration (comma-separated list of allowed origins)
# For production, replace with your actual domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend API URL
# This should point to your backend API endpoint
VITE_API_URL=https://api.yourdomain.com/api

# Rate Limiting (Optional - for distributed rate limiting with Redis)
# Leave empty to use in-memory rate limiting
RATELIMIT_STORAGE_URL=
RATELIMIT_ENABLED=true

# CSRF Protection
# Enable CSRF protection for state-changing operations (POST, PUT, DELETE)
CSRF_ENABLED=true

# Notes:
# 1. Generate SECRET_KEY using: openssl rand -hex 32
# 2. In production, never commit this file to version control
# 3. Update CORS_ORIGINS with your actual frontend domain(s)
# 4. Update VITE_API_URL with your actual backend API URL
# 5. Use strong passwords for POSTGRES_PASSWORD

